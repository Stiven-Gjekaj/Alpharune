#!/bin/sh
# Make the directory for the files of DELTARUNE, so that an AFC tool can show it.
mkdir -p /var/mobile/Media/Alpharune/save
chown -R mobile:mobile /var/mobile/Media/Alpharune
# Show the new icon on the home screen. uicache runs as the mobile user,
# because SpringBoard reads the cache of that user.
if [ -x /usr/bin/uicache ]; then
    su mobile -c /usr/bin/uicache || /usr/bin/uicache
fi
exit 0
